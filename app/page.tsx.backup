"use client";
import { useState } from "react";
import StoryboardTable, { Shot } from "./components/StoryboardTable";

export default function Home() {
  const [story, setStory] = useState("一个戴眼镜的青年在便利店收银台前犹豫地拿起一罐咖啡,最后放回原处,转身离开。");
  const [style, setStyle] = useState("日系动画");
  const [duration, setDuration] = useState(30);
  const [loading, setLoading] = useState(false);
  const [shots, setShots] = useState<Shot[] | null>(null);
  const [err, setErr] = useState("");

  const handleGenerate = async () => {
    setLoading(true);
    setErr("");
    setShots(null);
    try {
      const res = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ story, style, duration }),
      });
      const data = await res.json();
      if (data.error) setErr(data.error);
      else setShots(data.shots);
    } catch (e: any) {
      setErr(e.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="min-h-screen bg-gradient-to-br from-slate-50 to-violet-50 p-6">
      <div className="max-w-6xl mx-auto">
        <header className="text-center mb-8 print:hidden">
          <h1 className="text-4xl font-bold bg-gradient-to-r from-violet-600 to-pink-500 bg-clip-text text-transparent">
            AI 絵コンテ生成器
          </h1>
          <p className="text-slate-500 mt-2">日式动画工业级分镜表 · 实时编辑 · AI 出图</p>
        </header>

        <div className="bg-white rounded-2xl shadow-lg p-6 space-y-4 print:hidden">
          <div>
            <label className="text-sm font-semibold text-slate-700">剧情</label>
            <textarea
              value={story}
              onChange={(e) => setStory(e.target.value)}
              rows={3}
              className="w-full mt-1 p-3 border border-slate-300 rounded-lg outline-none focus:border-violet-500"
            />
          </div>
          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text-sm font-semibold text-slate-700">风格</label>
              <select
                value={style}
                onChange={(e) => setStyle(e.target.value)}
                className="w-full mt-1 p-3 border border-slate-300 rounded-lg outline-none focus:border-violet-500"
              >
                <option>日系动画</option>
                <option>电影感</option>
                <option>Vlog</option>
                <option>纪录片</option>
                <option>赛博朋克</option>
                <option>水墨国风</option>
              </select>
            </div>
            <div>
              <label className="text-sm font-semibold text-slate-700">总时长(秒)</label>
              <input
                type="number"
                value={duration}
                onChange={(e) => setDuration(Number(e.target.value))}
                className="w-full mt-1 p-3 border border-slate-300 rounded-lg outline-none focus:border-violet-500"
              />
            </div>
          </div>
          <button
            onClick={handleGenerate}
            disabled={loading}
            className="w-full py-4 bg-gradient-to-r from-violet-600 to-pink-500 text-white font-bold rounded-lg hover:opacity-90 disabled:opacity-50 text-lg"
          >
            {loading ? "AI 正在拆分镜头..." : "一键生成分镜"}
          </button>
          {err && <div className="p-3 bg-red-50 text-red-600 rounded-lg text-sm">{err}</div>}
        </div>

        {shots && <StoryboardTable initialShots={shots} />}
      </div>
    </main>
  );
}
